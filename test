import Foundation
import Observation

@MainActor
@Observable
final class ExpensesViewModel {
    struct Slice: Identifiable, Equatable {
        let category: ExpenseCategory
        let amount: Money
        var id: ExpenseCategory { category }
    }

    private(set) var month: Date
    private(set) var slices: [Slice] = []
    private(set) var total: Money = .zero
    private(set) var errorMessage: String?

    private let useCase: GetMonthlySummaryUseCase
    private let calendar: Calendar

    init(useCase: GetMonthlySummaryUseCase, month: Date = .now, calendar: Calendar = .current) {
        self.useCase = useCase
        self.month = month
        self.calendar = calendar
    }

    var canGoForward: Bool {
        !calendar.isDate(month, equalTo: .now, toGranularity: .month)
    }

    func load() async {
        do {
            let summary = try await useCase.execute(month: month)
            total = summary.total
            slices = summary.byCategory
                .map { Slice(category: $0.key, amount: $0.value) }
                .sorted { $0.amount.minorUnits > $1.amount.minorUnits }
            errorMessage = nil
        } catch {
            errorMessage = "Couldn't load your spending. Please try again."
        }
    }

    func showPreviousMonth() async { await shift(by: -1) }
    func showNextMonth() async { if canGoForward { await shift(by: 1) } }

    private func shift(by months: Int) async {
        guard let next = calendar.date(byAdding: .month, value: months, to: month) else { return }
        month = next
        await load()
    }
}
