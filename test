import XCTest
@testable import MiniWallet

final class TransactionExpenseTests: XCTestCase {
    private let day = Date(timeIntervalSince1970: 1_790_000_000)

    private func tx(_ id: String, _ paise: Int, _ direction: Transaction.Direction,
                    _ status: Transaction.Status, _ category: ExpenseCategory? = nil) -> Transaction {
        Transaction(id: id, counterparty: "X", amount: Money(minorUnits: paise),
                    direction: direction, status: status, occurredAt: day,
                    note: nil, category: category)
    }

    func test_onlyCompletedDebitsCountAsExpenses() {
        XCTAssertNotNil(tx("1", 100, .debit, .completed).asExpense)
        XCTAssertNil(tx("2", 100, .credit, .completed).asExpense)
        XCTAssertNil(tx("3", 100, .debit, .pending).asExpense)
        XCTAssertNil(tx("4", 100, .debit, .failed).asExpense)
        XCTAssertNil(tx("5", 100, .debit, .reversed).asExpense)
    }

    func test_uncategorisedDebitFallsBackToOther() {
        XCTAssertEqual(tx("1", 100, .debit, .completed).asExpense?.category, .other)
        XCTAssertEqual(tx("2", 100, .debit, .completed, .food).asExpense?.category, .food)
    }

    func test_summaryFromTransactions_ignoresCreditsAndPending() async throws {
        let all = [
            tx("1", 47_000, .debit, .completed, .food),
            tx("2", 1_250_000, .credit, .completed),
            tx("3", 89_900, .debit, .pending, .bills)
        ]
        let repo = TransactionExpenseRepository { all }
        let useCase = GetMonthlySummaryUseCase(repository: repo)
        let summary = try await useCase.execute(month: day)
        XCTAssertEqual(summary.total, Money(minorUnits: 47_000))
        XCTAssertEqual(summary.byCategory[.food], Money(minorUnits: 47_000))
    }
}
