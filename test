final class PinnedClientTests: XCTestCase {
    private struct RateLimit: Decodable { let resources: Resources
        struct Resources: Decodable { let core: Core }
        struct Core: Decodable { let limit: Int }
    }

    func test_pinnedClient_succeedsWithCorrectPins() async throws {
        let client = APIClient.pinned(
            baseURL: URL(string: "https://api.github.com")!,
            pins: ["api.github.com": ["PASTE_LEAF_PIN=", "PASTE_INTERMEDIATE_PIN="]])
        do {
            let result = try await client.get("rate_limit", as: RateLimit.self)
            XCTAssertGreaterThan(result.resources.core.limit, 0)
        } catch APIError.transport(let detail) where detail.lowercased().contains("offline") {
            throw XCTSkip("Offline")
        }
    }

    func test_pinnedClient_failsWithWrongPin() async {
        let client = APIClient.pinned(
            baseURL: URL(string: "https://api.github.com")!,
            pins: ["api.github.com": ["AAAA-wrong="]])
        do {
            _ = try await client.get("rate_limit", as: RateLimit.self)
            XCTFail("Pin mismatch should block the request")
        } catch APIError.transport { /* expected */ }
        catch { XCTFail("Unexpected error: \(error)") }
    }
}
