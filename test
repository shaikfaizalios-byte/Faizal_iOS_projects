import XCTest
@testable import MiniWallet

final class GetMonthlySummaryUseCaseTests: XCTestCase {
    private var calendar: Calendar {
        var c = Calendar(identifier: .gregorian)
        c.timeZone = TimeZone(identifier: "UTC")!
        return c
    }

    private func date(_ y: Int, _ m: Int, _ d: Int, _ h: Int = 12, _ min: Int = 0, _ s: Int = 0) -> Date {
        calendar.date(from: DateComponents(year: y, month: m, day: d, hour: h, minute: min, second: s))!
    }

    private func expense(_ paise: Int, _ category: ExpenseCategory, on date: Date) -> Expense {
        Expense(amount: Money(minorUnits: paise), category: category, date: date)
    }

    private func makeUseCase(_ items: [Expense]) -> GetMonthlySummaryUseCase {
        GetMonthlySummaryUseCase(repository: InMemoryExpenseRepository(items: items), calendar: calendar)
    }

    func test_groupsTotalsByCategory() async throws {
        let useCase = makeUseCase([
            expense(47_000, .food, on: date(2026, 9, 5)),
            expense(10_050, .food, on: date(2026, 9, 20)),
            expense(89_900, .bills, on: date(2026, 9, 26))
        ])
        let summary = try await useCase.execute(month: date(2026, 9, 10))
        XCTAssertEqual(summary.byCategory[.food], Money(minorUnits: 57_050))
        XCTAssertEqual(summary.byCategory[.bills], Money(minorUnits: 89_900))
        XCTAssertEqual(summary.total, Money(minorUnits: 146_950))
    }

    func test_monthBoundaries_lastSecondIncluded_nextMonthFirstSecondExcluded() async throws {
        let useCase = makeUseCase([
            expense(100, .food, on: date(2026, 9, 1, 0, 0, 0)),
            expense(200, .food, on: date(2026, 9, 30, 23, 59, 59)),
            expense(400, .food, on: date(2026, 10, 1, 0, 0, 0)),
            expense(800, .food, on: date(2026, 8, 31, 23, 59, 59))
        ])
        let summary = try await useCase.execute(month: date(2026, 9, 15))
        XCTAssertEqual(summary.total, Money(minorUnits: 300))
    }

    func test_emptyMonth_returnsZero() async throws {
        let summary = try await makeUseCase([]).execute(month: date(2026, 9, 15))
        XCTAssertEqual(summary.total, .zero)
        XCTAssertTrue(summary.byCategory.isEmpty)
    }

    func test_noRoundingDrift_manySmallAmounts() async throws {
        // 0.10 added 1,000 times must be exactly 100.00 (10,000 paise).
        let items = (0..<1_000).map { _ in expense(10, .other, on: date(2026, 9, 3)) }
        let summary = try await makeUseCase(items).execute(month: date(2026, 9, 15))
        XCTAssertEqual(summary.total, Money(minorUnits: 10_000))
    }
}
